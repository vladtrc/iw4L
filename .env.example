# Copy to `.env` and set your games root (folder that contains game trees).
# Never commit `.env`.
IW4L_GAMES=/path/to/cod-games

# The two IW5 trees `g_iw5_dual_width_capture` decodes the same map from: the
# Steam re-release of MW3 (x64 zones) and a retail x86 install. Both are game
# trees, not roots, so the gate survives IW4L_GAMES moving. Optional; without
# them the gate skips. X86 defaults to `$IW4L_GAMES/iw5_full_game`.
IW4L_IW5_X64_GAMES="/path/to/Steam/steamapps/common/Call of Duty Modern Warfare 3"
IW4L_IW5_X86_GAMES=/path/to/cod-games/iw5_full_game

# Deploy target for `make deploy|publish|logs <channel>` (ssh user@host)
# and the iw4l root on that machine. Optional for local play.
# `make provision` uses the same host and IW4L_RELEASE_KEY.
IW4L_DEPLOY_HOST=user@host
IW4L_DEPLOY_ROOT=/srv/iw4l
# Private CA / TLS key used to sign master QUIC + release HTTPS certs. Keep it
# outside the repo.
IW4L_RELEASE_KEY=/path/to/release-ca

# Runtime master used by `make menu` and by a portable Windows folder.
# The server may be offline; the menu still starts and reconnects in background.
IW4L_MASTER_ADDR=master.example.net:4433
IW4L_MASTER_SERVER_NAME=iw4l-prod
IW4L_MASTER_CA_CERT=${IW4L_RELEASE_KEY}/iw4l-ca.pem
